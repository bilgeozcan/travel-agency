{
  "lambda-basic-execution": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:Scan",
            "dynamodb:PutItem",
            "dynamodb:UpdateItem",
            "dynamodb:Batch*",
            "dynamodb:DeleteItem",
            "s3:PutObject",
            "s3:GetObject",
            "sqs:SendMessage",
            "ssm:PutParameter",
            "ssm:GetParameter",
            "kms:Decrypt",
            "cognito-idp:AdminCreateUser",
            "cognito-idp:AdminSetUserPassword",
            "cognito-idp:AdminInitiateAuth",
            "cognito-idp:AdminRespondToAuthChallenge",
            "cognito-idp:DescribeUserPool",
            "cognito-idp:GetUser",
            "cognito-idp:AdminAddUserToGroup",
            "cognito-idp:AdminDeleteUser",
            "cognito-idp:AdminUpdateUserAttributes",
            "cognito-idp:AdminGetUser",
            "cognito-idp:ListUsers"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy",
    "tags": {}
  },
  "${booking_userpool}": {
    "resource_type": "cognito_idp",
    "password_policy": {
      "minimum_length": 8,
      "require_uppercase": true,
      "require_symbols": true,
      "require_lowercase": true,
      "require_numbers": true
    },
    "auto_verified_attributes": [
      "email"
    ],
    "sms_configuration": {},
    "username_attributes": [
      "email"
    ],
    "custom_attributes": [],
    "client": {
        "client_name": "client-app",
        "generate_secret": false,
        "explicit_auth_flows": [
            "ALLOW_ADMIN_USER_PASSWORD_AUTH",
            "ALLOW_USER_PASSWORD_AUTH",
            "ALLOW_CUSTOM_AUTH",
            "ALLOW_USER_SRP_AUTH",
            "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "read_attributes": [
            "email",
            "email_verified",
            "given_name",
            "family_name",
            "picture"
        ],
        "write_attributes": [
            "email",
            "given_name",
            "family_name",
            "picture"
        ]
    },
    "tags": {}
  },
  "${tour_catalog_table}": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 2,
    "write_capacity": 2
  },
  "${travel_agents_table}": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "email",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 2,
    "write_capacity": 2,
    "tags": {
      "purpose": "travel-agent-allowlist"
    }
  },
  "${tour_reviews_table}": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "sort_key_name": "createdAt",
    "sort_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 2,
    "write_capacity": 2,
    "tags": {}
  },
  "booking-status-updater-policy": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "dynamodb:Scan",
            "dynamodb:UpdateItem",
            "sqs:SendMessage"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy",
    "tags": {}
  },
  "reports-handler-policy": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "dynamodb:UpdateItem",
            "sqs:ReceiveMessage",
            "sqs:DeleteMessage",
            "sqs:GetQueueAttributes"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy",
    "tags": {}
  },
  "reports-sender-policy": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "dynamodb:Query",
            "cognito-idp:AdminGetUser"
          ],
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "ses:SendRawEmail"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:ses:${region}:${account_id}:identity/${sender_email}",
            "arn:aws:ses:${region}:${account_id}:identity/${recipient_email}"
          ]
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy",
    "tags": {}
  },
  "booking-completion-schedule": {
    "resource_type": "eventbridge_rule",
    "rule_type": "schedule",
    "region": "${region}",
    "expression": "cron(5 0 * * ? *)",
    "tags": {
      "purpose": "booking-lifecycle"
    }
  },
  "${bookings_table}": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 2,
    "write_capacity": 2,
    "tags": {}
  },
  "${feedbacks_table}": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "bookingId",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 2,
    "write_capacity": 2,
    "tags": {}
  },
  "${reports_bucket}": {
    "resource_type": "s3_bucket",
    "acl": "private",
    "cors": [],
    "tags": {
      "purpose": "reports-storage"
    }
  },
  "${report_cache_table}": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 2,
    "write_capacity": 2,
    "ttl_attribute_name": "ttl",
    "tags": {
      "purpose": "reports-cache"
    }
  },
  "${reports_table}": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "period",
    "hash_key_type": "S",
    "sort_key_name": "sortKey",
    "sort_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 2,
    "write_capacity": 2,
    "tags": {
      "purpose": "reports-pipeline"
    }
  },
  "${booking_documents_bucket}": {
    "resource_type": "s3_bucket",
    "acl": "private",
    "cors": [],
    "public_access_block": {
      "block_public_acls": true,
      "ignore_public_acls": true,
      "block_public_policy": true,
      "restrict_public_buckets": true
    },
    "tags": {
      "purpose": "booking-documents"
    }
  },
  "${reports_dlq}": {
    "resource_type": "sqs_queue",
    "region": "${region}",
    "visibility_timeout": 30,
    "message_retention_period": 1209600,
    "tags": {
      "purpose": "reports-pipeline-dlq"
    }
  },
  "${reports_queue}": {
    "resource_type": "sqs_queue",
    "region": "${region}",
    "visibility_timeout": 60,
    "message_retention_period": 345600,
    "receive_message_wait_time_seconds": 10,
    "redrive_policy": {
      "deadLetterTargetArn": "arn:aws:sqs:${region}:${account_id}:${reports_dlq}",
      "maxReceiveCount": 3
    },
    "dependencies": [
      {
        "resource_name": "${reports_dlq}",
        "resource_type": "sqs_queue"
      }
    ],
    "tags": {
      "purpose": "reports-pipeline"
    }
  },
  "reports-sender-schedule": {
    "resource_type": "eventbridge_rule",
    "rule_type": "schedule",
    "region": "${region}",
    "expression": "cron(0 14 * * ? *)",
    "tags": {
      "purpose": "reports-pipeline"
    }
  }
}